# --- deps ---
node_modules/
.pnpm-store/

# --- build output ---
dist/
build/
out/
.next/
*.tsbuildinfo
.turbo/

# --- env & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- runtime artifacts ---
logs/
*.log
coverage/
.nyc_output/

# --- agent runtime state ---
# Claude Agent SDK session transcripts can contain customer data; never commit.
.claude-sessions/
.agent-runs/

# --- editor / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- local scratch ---
# Specs and tickets ARE committed: they are the work's memory and the skills
# read them. Only throwaway experiments stay local.
.scratch/local/

# --- local Claude session settings (NMEM_SPACE 等环境固化，不进仓) ---
.claude/settings.local.json

# --- eval runs (transient); baselines are committed ---
packages/evals/runs/

# --- 临时交接产物 ---
*.bundle

# --- Python 编译缓存（站点生成器是 Python）---
__pycache__/
*.pyc

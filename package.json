{
  "name": "mas-router-method",
  "version": "0.1.0",
  "private": true,
  "description": "A native-agent product: a TikTok brand-content agent plus the workbench that operates it.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "main:check": "pnpm --filter @mas/bot-gateway check",
    "main:dev": "pnpm --filter @mas/bot-gateway dev",
    "main:simulate": "pnpm --filter @mas/bot-gateway simulate",
    "main:knowledge": "pnpm --filter @mas/consult materialize",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "main:usage": "python3 scripts/feishu-usage-snapshot.py --days 14",
    "main:blind": "python3 scripts/build-blind-review.py --out /tmp/main-blind.json --key .data/blind-key.json",
    "main:live": "python3 scripts/feishu-live-check.py",
    "main:human-review": "python3 scripts/build-blind-review.py --out .data/blind-30-human.json --key .data/blind-key.json --markdown docs/evals/main-agent-human-review-packet.md"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}

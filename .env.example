# ---- Anthropic runtime ----
ANTHROPIC_API_KEY=sk-ant-...
# Model the agent runtime calls. Keep it here so eval runs and prod agree.
AGENT_MODEL=claude-sonnet-4-6
# Hard ceiling per agent run, in USD. The runtime must fail closed on this.
AGENT_MAX_COST_USD=0.50
AGENT_MAX_TURNS=40

# ---- Workbench ----
# Session cookie signing key. Generate with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Feishu/Lark OAuth app (workbench login via 飞书扫码)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/callback/feishu

# ---- Bot gateway (Feishu event subscription) ----
# Verification token + encrypt key from the Feishu open-platform console.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
BOT_GATEWAY_PORT=3001

# ---- Main agent (capability-graph consultant) ----
# ws = Feishu long connection (no public URL); http = webhook at POST /events.
FEISHU_EVENT_MODE=ws
FEISHU_BOT_NAME=Main
# Optional: filled automatically from /bot/v3/info at startup.
FEISHU_BOT_OPEN_ID=
# mention = only answer group messages that @ the bot; all = answer every message.
MAIN_AGENT_GROUP_MODE=mention
# Comma-separated allow-lists; empty means everyone the bot can see.
MAIN_AGENT_ALLOWED_CHAT_IDS=
MAIN_AGENT_ALLOWED_OPEN_IDS=
MAIN_AGENT_CONCURRENCY=2
MAIN_AGENT_MAX_ANSWER_CHARS=3400
MAIN_AGENT_MESSAGE_FORMAT=text
MAIN_AGENT_ACK_AFTER_MS=4000
MAIN_AGENT_ANSWER_TIMEOUT_MS=90000
MAIN_AGENT_LOG_LEVEL=info
# auto = use ANTHROPIC_API_KEY / OPENAI_API_KEY if present, else grounded answers.
# off = never call a model (deterministic, free). anthropic / openai = force one.
MAIN_AGENT_LLM=auto
MAIN_AGENT_LLM_MODEL=
MAIN_AGENT_LLM_BASE_URL=
MAIN_AGENT_LLM_API_KEY=
# Only for local HTTP testing; never in production.
MAIN_AGENT_ALLOW_UNVERIFIED_HTTP=false

# Eval LLM judge. off = deterministic rubric only; llm = use the key below.
MAIN_AGENT_JUDGE=off
MAIN_AGENT_JUDGE_MODEL=
MAIN_AGENT_JUDGE_BASE_URL=
MAIN_AGENT_JUDGE_API_KEY=

# Thread session store. SQLite survives a gateway restart (single host).
# Use :memory: for tests or a throwaway process.
MAIN_AGENT_SESSION_DB=.data/main-agent-sessions.db

# ---- Data ----
DATABASE_URL=file:./.data/dev.db
